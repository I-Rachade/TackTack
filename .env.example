# Clé API Anthropic (Claude) pour détecter les intentions d'achat.
# Sans clé, TackTack utilise une détection simple par mots-clés.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'analyse des commentaires.
CLAUDE_MODEL=claude-opus-5-5

# Clé Euler Stream (optionnelle) : améliore la fiabilité de la connexion TikTok Live.
EULER_API_KEY=

PORT=3000

# Fichier où TackTack garde les produits et les clients intéressés.
DATA_FILE=data/tacktack.json

# Adresse publique de TackTack (https://...), nécessaire pour WhatsApp et PayGate.
PUBLIC_URL=

# WhatsApp Business Platform (Meta). Sans ces valeurs, les messages restent dans TackTack (démo).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# PayGate Global : liens de paiement Flooz et T-Money. Sans clé, page de paiement de démo.
PAYGATE_TOKEN=
