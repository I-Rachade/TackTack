# Clé API Anthropic (Claude) pour détecter les intentions d'achat.
# Sans clé, TackTack utilise une détection simple par mots-clés.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'analyse des commentaires.
CLAUDE_MODEL=claude-opus-5-5

# Clé Euler Stream (optionnelle) : améliore la fiabilité de la connexion TikTok Live.
EULER_API_KEY=

PORT=3000
